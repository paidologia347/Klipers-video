<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1) Download Video URL (direct file URL)" />

        <EditText
            android:id="@+id/etVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com/video.mp4"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2) Pilih Video Sumber" />

        <Button
            android:id="@+id/btnPickVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Video" />

        <TextView
            android:id="@+id/tvSelectedVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada video dipilih" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3) Manual Cut" />

        <EditText
            android:id="@+id/etStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start (contoh 00:00:10)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="End (contoh 00:00:25)"
            android:inputType="text" />

        <Button
            android:id="@+id/btnManualCut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jalankan Manual Cut" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="4) AutoCut Recipe" />

        <Button
            android:id="@+id/btnLoadRecipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load Recipe TXT" />

        <EditText
            android:id="@+id/etRecipe"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="top|start"
            android:hint="Satu segmen per baris: 00:00:10-00:00:20"
            android:inputType="textMultiLine"
            android:scrollbars="vertical" />

        <Button
            android:id="@+id/btnAutoCut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jalankan AutoCut" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEFEF"
            android:minHeight="120dp"
            android:padding="8dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
